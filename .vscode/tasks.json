{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Toggle gitignored files",
      "detail": "Show or hide gitignored files in the Explorer",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/toggle-gitignored.ps1"
      ],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
